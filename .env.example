# LLM connection
LLM_MODEL=provider/model-name
LLM_API_KEY=replace-with-api-key
# Set only when using a custom or proxy endpoint.
# LLM_BASE_URL=https://your-model-endpoint.example/v1

# Independent validation agent
VALIDATOR_LLM_MODEL=provider/model-name
VALIDATOR_LLM_API_KEY=replace-with-api-key
# Set only when using a custom or proxy endpoint.
# VALIDATOR_LLM_BASE_URL=https://your-validator-endpoint.example/v1

# Container sandbox
CONTAINER_ENGINE=podman
SANDBOX_MODE=dind
# Build this image once before running experiments; replace podman with docker
# when CONTAINER_ENGINE=docker.
# podman build -t installbench:22.04-dind -f benchmark-images/Dockerfile.dind benchmark-images
DEFAULT_CONTAINER_IMAGE=installbench:22.04-dind
REPOSITORY_DIR=/workspace/repository

# Experiment identity
# Keep one ID for every task and repeated run in the same experimental batch.
EXPERIMENT_ID=final-thesis-run

# Execution limits
COMMAND_TIMEOUT_SECONDS=300
MAX_AGENT_ITERATIONS=50
MAX_VALIDATOR_ITERATIONS=25

# Dataset and artifact paths
TASKS_DIR=tasks
RESULTS_DIR=results
WORKSPACE_DIR=workspace
INSTALLATION_PROMPT_PATH=installbench/prompts/installation_prompt.md
VALIDATION_PROMPT_PATH=installbench/prompts/validation_prompt.md
