# Installation agent
INSTALLATION_LLM_MODEL=provider/model-name
INSTALLATION_LLM_API_KEY=replace-with-api-key
INSTALLATION_LLM_BASE_URL=https://your-installation-endpoint.example/v1

# Independent validation agent
VALIDATION_LLM_MODEL=provider/model-name
VALIDATION_LLM_API_KEY=replace-with-api-key
VALIDATION_LLM_BASE_URL=https://your-validation-endpoint.example/v1

# Container sandbox
CONTAINER_ENGINE=podman
SANDBOX_MODE=dind
DEFAULT_CONTAINER_IMAGE=installbench:22.04-dind
REPOSITORY_DIR=/workspace/repository

# Experiment identity
# Keep one ID for every task and repeated run in the same experimental batch.
EXPERIMENT_ID=final-thesis-run

# Execution limits
COMMAND_TIMEOUT_SECONDS=300
MAX_INSTALLATION_ITERATIONS=50
MAX_VALIDATION_ITERATIONS=25

# Dataset and artifact paths
TASKS_DIR=tasks
RESULTS_DIR=results
WORKSPACE_DIR=workspace
INSTALLATION_PROMPT_PATH=installbench/prompts/installation_prompt.md
VALIDATION_PROMPT_PATH=installbench/prompts/validation_prompt.md
